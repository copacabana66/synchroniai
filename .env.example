# ── Supabase ──────────────────────────────────────────────────────────────────
# Créez un projet sur https://supabase.com → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── IA — Choisissez UNE des options ci-dessous ────────────────────────────────

# Option 1 : Groq (GRATUIT — 14 400 req/jour, très rapide)
# → https://console.groq.com → API Keys → Create key
# Inclut Whisper pour la transcription audio
GROQ_API_KEY=gsk_...

# Option 2 : OpenRouter (GRATUIT avec modèles :free)
# → https://openrouter.ai/keys → Create key
# Pas de transcription audio (texte uniquement)
OPENROUTER_API_KEY=sk-or-...

# Option 3 : Google Gemini (quota limité en free tier)
# → https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
